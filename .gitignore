# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/
.pytype/
.pyright/

# ---------------------------------------------------------------------------
# AI-Commander specific
# ---------------------------------------------------------------------------

# Debug artifacts
commander-debug.txt

# Session files (mirrored conversation history, reloaded on startup)
.aicsession
.aicsession[0-9]*
.aicsession*.lock
.aicsession*.tmp.*
.aicsession*.corrupt.*

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Secrets / credentials (never commit these)
# ---------------------------------------------------------------------------
pypi-token.txt
*.token
*.token.txt
*token.txt
!token-spec.md
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
credentials.json
secrets.json
